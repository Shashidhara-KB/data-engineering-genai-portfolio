[FTE] := SUM ( FactWorkforce[FTE] )

[Headcount] := DISTINCTCOUNT ( FactWorkforce[EmployeeKey] )

[Base Pay] := SUM ( FactWorkforce[BasePay] )

[Base Pay per FTE] := DIVIDE ( [Base Pay], [FTE] )

[FTE Prior Month] :=
CALCULATE ( [FTE], DATEADD ( DimDate[Date], -1, MONTH ) )

[FTE Movement] := [FTE] - [FTE Prior Month]

[FTE Movement %] := DIVIDE ( [FTE Movement], [FTE Prior Month] )
